#: includes/class-rules.php
#, php-format
msgid "%1$s allows no more than %2$s units."
msgstr "%1$s kann mit höchstens %2$s Stück bestellt werden."

#: includes/class-rules.php
#, php-format
msgid "%1$s requires at least %2$s units."
msgstr "%1$s muss mit mindestens %2$s Stück bestellt werden."

#: includes/class-rules.php
msgid "A minimum quantity cannot exceed its maximum quantity."
msgstr "Eine Mindestmenge darf die zugehörige Höchstmenge nicht überschreiten."

#: includes/class-rules.php
#, php-format
msgid "Add %1$s more units to reach the minimum quantity of %2$s."
msgstr "Noch %1$s Stück bis zur Mindestmenge von %2$s."

#: includes/class-rules.php
#, php-format
msgid "Add products worth %s more to reach the minimum order value."
msgstr "Noch %s Warenwert bis zum Mindestbestellwert."

#: includes/class-admin.php
msgid "Allow one product with quantity one"
msgstr "Genau ein Produkt mit Menge 1 zulassen"

#: includes/class-integration.php
