msgstr "Warenkorb-Regeln"

#: includes/history.php
msgid "Cart Rules with single-item carts, minimum quantities and order value, quantity limits and steps."
msgstr "Cart Rules mit Ein-Artikel-Warenkörben, Mindestmengen und Mindestbestellwert, Höchstmengen und Mengenschritten."

#: includes/class-admin.php
msgid "Changelog"
msgstr "Änderungsverlauf"

